{
	"name": "soderlind/loupe-search-multilingual",
	"description": "One Loupe Search index per language for sites translated with Polylang or WPML.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^12",
		"brain/monkey": "^2.6"
	},
	"autoload": {
		"psr-4": {
			"Soderlind\\Plugin\\LoupeSearchMultilingual\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Soderlind\\Plugin\\LoupeSearchMultilingual\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit"
	}
}
